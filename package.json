{
	"name": "shop-backend",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"prisma": {
		"seed": "ts-node src/prisma/seed.ts"
	},
	"scripts": {
		"build": "nest build",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "nest start",
		"start:dev": "dotenv -e .env.development -- nest start --watch",
		"start:debug": "NODE_ENV=development nest start --debug --watch",
		"start:prod": "NODE_ENV=production node dist/src/main",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "NODE_ENV=test jest --config ./test/jest-e2e.ts",
		"prisma:seed:dev": "dotenv -e .env.development -- npx prisma db seed",
		"prisma:studio:dev": "dotenv -e .env.development -- npx prisma studio",
		"prisma:generate:dev": "dotenv -e .env.development -- npx prisma generate",
		"prisma:migrate:dev": "dotenv -e .env.development -- npx prisma migrate dev",
		"prisma:studio:prod": "dotenv -e .env.production -- npx prisma studio",
		"prisma:generate:prod": "dotenv -e .env.production -- npx prisma generate",
		"prisma:migrate:prod": "dotenv -e .env.production -- npx prisma migrate deploy"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1030.0",
		"@nestjs/axios": "^3.1.3",
		"@nestjs/common": "^10.4.22",
		"@nestjs/config": "^3.3.0",
		"@nestjs/core": "^10.4.22",
		"@nestjs/jwt": "^10.2.0",
		"@nestjs/passport": "^10.0.3",
		"@nestjs/platform-express": "^10.4.22",
		"@nestjs/serve-static": "^4.0.2",
		"@nestjs/swagger": "^7.4.2",
		"@prisma/client": "^5.22.0",
		"@sentry/nestjs": "^10.48.0",
		"@sentry/node": "^10.48.0",
		"argon2": "^0.40.3",
		"axios": "^1.15.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.4",
		"fast-csv": "^5.0.5",
		"nest-winston": "^1.10.2",
		"nestjs-zod": "^5.3.0",
		"passport": "^0.7.0",
		"passport-jwt": "^4.0.1",
		"passport-local": "^1.0.0",
		"pg": "^8.20.0",
		"reflect-metadata": "^0.1.14",
		"rxjs": "^7.8.2",
		"slugify": "^1.6.9",
		"winston": "^3.19.0",
		"winston-transport": "^4.9.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@nestjs/cli": "^10.4.9",
		"@nestjs/schematics": "^10.2.3",
		"@nestjs/testing": "^10.4.22",
		"@types/express": "^4.17.25",
		"@types/jest": "^29.5.14",
		"@types/multer": "^1.4.13",
		"@types/node": "^20.19.39",
		"@types/passport-jwt": "^4.0.1",
		"@types/passport-local": "^1.0.38",
		"@types/supertest": "^6.0.3",
		"@typescript-eslint/eslint-plugin": "^6.21.0",
		"@typescript-eslint/parser": "^6.21.0",
		"dotenv-cli": "^8.0.0",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^9.1.2",
		"eslint-plugin-prettier": "^5.5.5",
		"jest": "^29.7.0",
		"prettier": "^3.8.3",
		"prisma": "^5.22.0",
		"source-map-support": "^0.5.21",
		"supertest": "^6.3.4",
		"ts-jest": "^29.4.9",
		"ts-loader": "^9.5.7",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.9.3"
	},
	"jest": {
		"moduleNameMapper": {
			"^src/(.*)$": "<rootDir>/$1"
		},
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node"
	}
}
