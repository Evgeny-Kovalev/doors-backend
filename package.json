{
	"name": "shop-backend",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"prisma": {
		"seed": "ts-node src/prisma/seed.ts"
	},
	"scripts": {
		"build": "nest build",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/src/main",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "NODE_ENV=test jest --config ./test/jest-e2e.ts",
		"prisma:studio:prod": "dotenv -e .env.production -- npx prisma studio",
		"prisma:generate:prod": "dotenv -e .env.production -- npx prisma generate",
		"prisma:migrate:prod": "dotenv -e .env.production -- npx prisma migrate deploy"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1073.0",
		"@nestjs/axios": "^4.0.1",
		"@nestjs/common": "^11.1.27",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.1.27",
		"@nestjs/jwt": "^11.0.2",
		"@nestjs/passport": "^11.0.5",
		"@nestjs/platform-express": "^11.1.27",
		"@nestjs/serve-static": "^5.0.5",
		"@nestjs/swagger": "^11.4.4",
		"@prisma/adapter-pg": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"@prisma/client-runtime-utils": "^7.8.0",
		"@sentry/nestjs": "^10.59.0",
		"@sentry/node": "^10.59.0",
		"argon2": "^0.44.0",
		"axios": "^1.18.0",
		"fast-csv": "^5.0.7",
		"multer": "^2.2.0",
		"nest-winston": "^1.10.2",
		"nestjs-zod": "^5.4.0",
		"passport": "^0.7.0",
		"passport-jwt": "^4.0.1",
		"passport-local": "^1.0.0",
		"pg": "^8.22.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"slugify": "^1.6.9",
		"winston": "^3.19.0",
		"winston-transport": "^4.9.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@nestjs/cli": "^11.0.23",
		"@nestjs/schematics": "^11.1.0",
		"@nestjs/testing": "^11.1.27",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/multer": "^2.1.0",
		"@types/node": "^26.0.0",
		"@types/passport-jwt": "^4.0.1",
		"@types/passport-local": "^1.0.38",
		"@types/supertest": "^7.2.0",
		"@typescript-eslint/eslint-plugin": "^8.61.1",
		"@typescript-eslint/parser": "^8.61.1",
		"dotenv-cli": "^11.0.0",
		"eslint": "^10.5.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"jest": "^30.4.2",
		"prettier": "^3.8.4",
		"prisma": "^7.8.0",
		"source-map-support": "^0.5.21",
		"supertest": "^7.2.2",
		"ts-jest": "^29.4.11",
		"ts-loader": "^9.6.1",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^6.0.3"
	},
	"jest": {
		"moduleNameMapper": {
			"^src/(.*)$": "<rootDir>/$1"
		},
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node"
	}
}
