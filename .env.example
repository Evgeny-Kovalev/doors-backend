NODE_ENV=development
PORT=4000
APP_FILES_URL=http://localhost:4000/files

DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost:5432
DB_NAME=db_name

# Local / PM2 on host: use localhost
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/db_name"
# Docker Compose (api container → db service): use host `db`
# DB_HOST=db:5432
# DATABASE_URL="postgresql://postgres:postgres@db:5432/db_name"

AT_SECRET=at-secret
RT_SECRET=rt-secret

TELEGRAM_BOT_TOKEN=TOKEN
TELEGRAM_CHAT_IDS=IDS

SENTRY_DSN=

S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

CORS_ORIGINS=http://localhost:3000,http://localhost:3001
